# Copy to .env.local and fill in. Never commit real keys.
# Local Supabase (backend dev): run `npm run db:start`, then copy API_URL and
# ANON_KEY from `npx supabase status -o env` into the two lines below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = UI uses src/services/mock instead of Supabase (no Docker needed)
NEXT_PUBLIC_USE_MOCKS=true

# Backend only (SERVICE_ROLE_KEY from `npx supabase status -o env`). Used by
# `npm run test:db` and by the server-only Strava code (src/lib/supabase/admin.ts).
# Never prefix with NEXT_PUBLIC_, never put the hosted project's key here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Strava import (docs/DEPLOY.md section 7). Leave empty to hide
# "Connect Strava". Server only: never prefix with NEXT_PUBLIC_.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
