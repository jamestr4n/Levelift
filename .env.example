# Copy to .env.local and fill in. Never commit real keys.
# Local Supabase (backend dev): run `npm run db:start`, then copy API_URL and
# ANON_KEY from `npx supabase status -o env` into the two lines below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = UI uses src/services/mock instead of Supabase (no Docker needed)
NEXT_PUBLIC_USE_MOCKS=true

# Backend only, for `npm run test:db` against LOCAL Supabase (SERVICE_ROLE_KEY
# from `npx supabase status -o env`). Never prefix with NEXT_PUBLIC_, never use
# in app code, never put the hosted project's key here.
SUPABASE_SERVICE_ROLE_KEY=
